# ─────────────────────────────────────────────────────────────
# Reelforge environment
# Copy to .env.local and fill in. App runs in DEMO MODE with none of these.
# ─────────────────────────────────────────────────────────────

# Public site URL (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase (required for real accounts + cloud storage) ---
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. NEVER expose as NEXT_PUBLIC_*
SUPABASE_SERVICE_ROLE_KEY=

# --- Transcription (optional: enables real AI captions) ---
# Without this the editor generates a demo transcript so you can still build + test.
OPENAI_API_KEY=
TRANSCRIBE_MODEL=whisper-1

# --- Render worker (optional: enables server-side MP4 export) ---
# Shared secret between Next.js and worker/index.mjs
RENDER_WORKER_SECRET=
# Public base URL of the worker (only needed if the worker exposes an HTTP endpoint)
WORKER_PUBLIC_URL=

# ─── Render worker (worker/index.mjs) ───────────────────────
# These are read by the worker process, not by Next.js.
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_BUCKET=media
# WORKER_CONCURRENCY=1
# WORKER_POLL_MS=4000
# FFMPEG_PATH=/usr/bin/ffmpeg      (only needed when ffmpeg is not on PATH)
